{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cassius-ticket",
  "main": "src/index.tsx",
  "compatibility_date": "2026-07-01",
  "routes": [
    {
      "pattern": "cassius-ticket.tools97.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cassius-ticket",
      "database_id": "63e55a75-309a-4476-8893-a5b0196b5493",
      "migrations_dir": "./migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
